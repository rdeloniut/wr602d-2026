{% extends 'base.html.twig' %}

{% block title %}Fusion de PDF — Convertisseur PDF{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap">
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons+Round">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
{% endblock %}

{% block body %}
    {# ── NAVBAR ── #}
    <nav class="nav">
        <div class="nav-inner">
            <a href="{{ path('app_index') }}" class="nav-brand">
                <img src="{{ asset('mmi-pdf-converter.png') }}" alt="PDF Factory" style="height:100px;">
            </a>
            <div class="nav-actions">
                <a href="{{ path('app_index') }}" class="btn btn-outline">
                    <span class="material-icons-round" style="font-size:18px">arrow_back</span>
                    Accueil
                </a>
            </div>
        </div>
    </nav>

    {# ── TOOL PAGE ── #}
    <section class="tool-page">
        <div class="tool-page-inner">
            <div class="tool-page-header">
                <div class="tool-page-icon bg-green">
                    <i class="fa-solid fa-object-group"></i>
                </div>
                <div>
                    <h1>Fusion de PDF</h1>
                    <p>Fusionnez plusieurs fichiers PDF en un seul document</p>
                </div>
            </div>

            {% for message in app.flashes('error') %}
                <div class="tool-alert">
                    <span class="material-icons-round">error_outline</span>
                    <div>
                        <strong>Erreur</strong>
                        <p>{{ message }}</p>
                    </div>
                </div>
            {% endfor %}

            <div class="tool-form-card">
                {{ form_start(form, {'attr': {'class': 'tool-form'}}) }}
                    <div class="tool-form-group">
                        <label class="tool-form-label">
                            <span class="material-icons-round">file_copy</span>
                            Fichiers PDF
                        </label>
                        {{ form_widget(form.files, {'attr': {'class': 'tool-form-input', 'accept': '.pdf', 'multiple': 'multiple'}}) }}
                        {{ form_errors(form.files) }}
                        <span class="tool-form-hint">Sélectionnez au moins 2 fichiers PDF à fusionner (max. 50 Mo chacun). L'ordre de fusion suit l'ordre de sélection.</span>
                    </div>

                    <div class="tool-form-actions">
                        {{ form_widget(form.submit, {'attr': {'class': 'btn btn-primary btn-lg'}}) }}
                    </div>
                {{ form_end(form) }}
            </div>

            <div class="tool-page-info">
                <div class="tool-info-item">
                    <span class="material-icons-round">merge_type</span>
                    <div>
                        <strong>Multi-fichiers</strong>
                        <p>Fusionnez autant de PDF que nécessaire</p>
                    </div>
                </div>
                <div class="tool-info-item">
                    <span class="material-icons-round">sort</span>
                    <div>
                        <strong>Ordre préservé</strong>
                        <p>Les pages restent dans l'ordre</p>
                    </div>
                </div>
                <div class="tool-info-item">
                    <span class="material-icons-round">lock</span>
                    <div>
                        <strong>Sécurisé</strong>
                        <p>Vos fichiers ne sont pas conservés</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ── FOOTER ── #}
    <footer class="footer">
        &copy; {{ 'now'|date('Y') }} PDF Factory. Tous droits réservés.
    </footer>
{% endblock %}
